# Dependencies
node_modules/
.bun/

# Build output
dist/
*.tsbuildinfo

# Bashwink runtime state (evidence logs, caches) — local to a working copy
.bashwink/

# Fixture repositories are generated by fixtures/create_fixtures.sh and are not part of
# this repository's history. Each fixture keeps its own Git baseline.
fixtures/*/
!fixtures/mock_provider.py
!fixtures/opencode.json
!fixtures/*.sh
!fixtures/BASELINES.txt
# Hand-written, committed on purpose: these are gate controls, not generated fixture
# repositories. They must be in history or the proofs are unreproducible.
!fixtures/lint-violation/
!fixtures/idempotent-resume/
!fixtures/tool-lifecycle/
!fixtures/phase1-demo/
!fixtures/runtime-health/
!fixtures/contract/
!fixtures/scope-fence/
!fixtures/interactive-entry/
!fixtures/native-offline/
!fixtures/release/
fixtures/release/_generated_egress.ts

# macOS
.DS_Store

# Generated audit packages — rebuilt on demand, not source
audit/

# Editor / agent scratch
.idea/
.vscode/
*.swp

# Python bytecode from the fixtures and scripts
__pycache__/

# Release candidate archives are build output, never committed
docs/bashwink/releases/*/*.tar.gz
build/
