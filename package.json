{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "bashwink",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "description": "Bashwink — an evidence-first coding agent built on a pinned OpenCode foundation.",
  "license": "MIT",
  "workspaces": {
    "packages": [
      "packages/*"
    ]
  },
  "scripts": {
    "build:standalone": "node --disable-warning=ExperimentalWarning scripts/standalone/build.mjs",
    "install:local": "node --disable-warning=ExperimentalWarning scripts/standalone/build.mjs --install",
    "test:standalone": "node --disable-warning=ExperimentalWarning --experimental-strip-types --test packages/bw-cli/test/standalone/*.test.ts",
    "test:standalone:install": "node --disable-warning=ExperimentalWarning scripts/standalone/test-install.mjs",
    "test:standalone:e2e": "node --disable-warning=ExperimentalWarning scripts/standalone/test-e2e.mjs",
    "test:standalone:independence": "node --disable-warning=ExperimentalWarning scripts/standalone/test-independence.mjs",
    "test": "bun test packages",
    "test:evidence": "bun test packages/bw-evidence",
    "test:cli": "bun test packages/bw-cli",
    "typecheck": "bun run --cwd packages/bw-evidence typecheck && bun run --cwd packages/bw-cli typecheck",
    "verify:docs": "python3 scripts/verify_bashwink_docs.py",
    "verify:evidence": "bun run packages/bw-evidence/src/cli.ts verify",
    "lint": "oxlint --deny-warnings packages",
    "lint:fix": "oxlint --fix packages",
    "lint:gate": "./scripts/check_lint_gate.sh",
    "format": "bun fmt --check packages",
    "format:fix": "bun fmt packages"
  },
  "devDependencies": {
    "@opencode/plugin": "2.3.2",
    "@types/bun": "1.4.3",
    "oxlint": "1.94.0",
    "typescript": "6.0.2"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
